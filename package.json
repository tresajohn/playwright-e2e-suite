{
  "name": "playwright-e2e-suite",
  "version": "1.0.0",
  "description": "Playwright E2E test suite — POM, BDD (Gherkin), CI/CD (GitHub Actions), Jira integration",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "report": "npx playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'tests/**/*.ts' 'steps/**/*.ts' '*.ts'",
    "format:check": "prettier --check 'tests/**/*.ts' 'steps/**/*.ts' '*.ts'",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "audit": "npm audit --audit-level=critical",
    "ai:validate": "npx tsx tests/ai-validation/index.ts",
    "test:contracts": "npx playwright test --project=contracts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "1.49.1",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "playwright-bdd": "^8.5.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0"
  }
}
