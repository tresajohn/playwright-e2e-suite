{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AITestScenario",
  "description": "Schema for AI-generated test scenarios before human review and promotion",
  "type": "object",
  "required": [
    "scenarioId",
    "requirementId",
    "title",
    "priority",
    "steps",
    "expectedResult",
    "reviewStatus",
    "generatedBy",
    "generatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioId": {
      "type": "string",
      "pattern": "^AI-[0-9]{3,}$",
      "description": "Unique ID for the AI-generated scenario"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[0-9]{3,}$",
      "description": "Links back to a known requirement in requirements.json"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^@[a-z]"
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "target"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": ["navigate", "fill", "click", "select", "verify", "wait", "check"]
          },
          "target": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "expectedResult": {
      "type": "string",
      "minLength": 10
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["pending", "approved", "rejected"]
    },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string" },
    "reviewedBy": { "type": "string" },
    "reviewNotes": { "type": "string" }
  }
}
